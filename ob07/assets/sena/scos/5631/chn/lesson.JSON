_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le11ob07re2aud01", "coverimg": "engenn5le11ob07re2img06.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le11ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Guide</span>: This is the khan.  The bazaar opened here in the 14th century! People still come for everything from soap powder to semiprecious stones. <br>\n<span class=\"strong\">Sally</span>: Do you mean gemstones?<br>\n<span class=\"strong\">Guide</span>: Yes. Let's go to a tea shop before we continue.", "id": 1, "time": "100", "image": "engenn5le11ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Did you say to take off my shoes?<br>\n<span class=\"strong\">Guide</span>: Yes, please.  Outside the mosque we looked at the dome. Many artisans carved those floral designs.  Inside they created these screened windows and decorative wood ceiling. It is a pleasant place to sit and relax.", "id": 2, "time": "29000", "image": "engenn5le11ob07re2img02.jpg"}, {"text": "<span class=\"strong\">Guide</span>: This is the Northern Cemetery. The Mamluk sultans built this place for the dead. People with no homes came to share the mausoleums. <br>\n<span class=\"strong\">Sally</span>: I don't quite understand.<br>\n<span class=\"strong\">Guide</span>: They lived here. They brought in electricity and established a post office. Even today the living and the dead share this cemetery.<br>\n<span class=\"strong\">Sally</span>: Fascinating!", "id": 3, "time": "54500", "image": "engenn5le11ob07re2img03.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Accident-Prone in Egypt"}, {"type": "unit_name", "content": "Visiting Cairo"}, {"type": "position", "content": 7}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 11}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe characteristics of different people and their jobs."}, {"type": "secondary_1", "content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations"}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations"}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations"}, {"type": "secondary_6", "content": "dentifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations"}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "background_image", "content": "engenn5le11ob07re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about events or actions that are finished."}, {"type": "text", "content": "To make questions and negatives in the Simple Past tense, you use the auxiliary <span class=\"italic\">do</span> in the past - <span class=\"italic\">did</span>. The main verb is in the base for - the infinitive without <span class=\"italic\">to</span> . Example : <span class=\"italic\">go, build  </span>"}, {"type": "text", "content": "Negative: <span class=\"italic\"> I didn't understand you.</span><br> Question: <span class=\"italic\">Did you ask me a question?</span>"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Verb \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Past Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"open<br> look<br> carve<br> create<br> establish<br> share\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"opened <br> looked<br> carved<br> created<br> established<br> shared\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"say<br> build<br> bring<br> understand<br> go<br> come<br> is\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"said<br> built<br> brought<br> understood<br> went<br> came<br> was/were\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Checking Your Understanding "}, {"type": "describer", "content": "When you want to check to see if you understand correctly, you can use different phrases."}, {"type": "text", "content": "Did you say ... ? <br>I don't quite understand."}, {"type": "text", "content": "Do you mean ... ? <br>Could you say that again, please?<br>Could you repeat that please? <br>Could you give me an example?"}, {"type": "example", "content": "Did you understand my question?"}, {"type": "example", "content": "I understood very well."}, {"type": "example", "content": "I didn't understand you."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gemstones"}, {"type": "definition", "content": "a jewel or precious stone"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: They sold gemstones in the markets."}, {"type": "audio", "content": "engenn5le11ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about Cairo."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "artisan "}, {"type": "definition", "content": "someone who does skilled work with their hands "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The artisans made wonderful things to sell to tourists."}, {"type": "audio", "content": "engenn5le11ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "floral"}, {"type": "definition", "content": "a design that looks like flowers "}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: They decorated with beautiful floral ornaments."}, {"type": "audio", "content": "engenn5le11ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "screened "}, {"type": "definition", "content": "covered or blocked from view "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The screened window had a beautiful mesh covering."}, {"type": "audio", "content": "engenn5le11ob07aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "decorative "}, {"type": "definition", "content": "making something more attractive "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She added decorative beads to the jacket."}, {"type": "audio", "content": "engenn5le11ob07aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mausoleum"}, {"type": "definition", "content": " a stone building where the dead are kept "}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": "Example: The mausoleums here have large open rooms."}, {"type": "audio", "content": "engenn5le11ob07aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "electricity"}, {"type": "definition", "content": " energy that produces light and power"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: Once the electricity was connected, the lights went on. "}, {"type": "audio", "content": "engenn5le11ob07aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "the living"}, {"type": "definition", "content": "those who are alive"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: This is a place for the dead and the living."}, {"type": "audio", "content": "engenn5le11ob07aud08"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a paragraph with 7 -10 sentences."}, {"type": "text", "content": "Describe a cemetery. What does it look like?"}, {"type": "text", "content": "Say who is buried there, such as famous people."}, {"type": "text", "content": "Write about any customs or traditions at the cemetery. "}, {"type": "text", "content": "Read your paragraph to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about a cemetery."}, {"type": "text", "content": "I describe a custom."}, {"type": "text", "content": "I read my paragraph aloud."}]}], "type": "sena"}